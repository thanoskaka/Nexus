# ── Nexus Portfolio — Environment Template ─────────────────────────────
# Copy to `.env.local` for local dev, or `.env` for Docker self-host.
# Never commit real credentials or secrets to the repository.
#
# Modes:
#   local (real Firebase)   → fill in Firebase vars below, then `npm run dev`
#   local (mock/no Firebase) → skip Firebase vars, set VITE_MOCK_MODE=mock, then `npm run dev:mock`
#   Docker self-host        → copy to .env, fill Firebase vars, `docker compose up --build`
#   Vercel production       → set everything via Vercel dashboard
#
# Docker quick-start:
#   cp .env.example .env
#   # Edit .env with your Firebase credentials
#   docker compose up --build -d
#   # Open http://localhost:6868
# ───────────────────────────────────────────────────────────────────────

# ── Firebase Client Config (required for real Firebase mode) ───────────
# Create a Firebase project at https://console.firebase.google.com
# Enable Authentication (Google provider) and Firestore Database.
# From Project Settings → General → Your apps → Web app:
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123def456"
# Optional: which portfolio to select by default
NEXT_PUBLIC_FIREBASE_PORTFOLIO_ID="default-portfolio"

# ── Mock Mode (no Firebase required) ───────────────────────────────────
# Set to "mock" and leave Firebase vars empty to run entirely offline.
# Uses fake in-memory data — perfect for demos, UI work, and testing.
# Start with: npm run dev:mock
# VITE_MOCK_MODE="mock"

# ── Data Namespace ─────────────────────────────────────────────────────
# IMPORTANT: Isolates which Firestore data partition this environment uses.
#   "local-dev" → safe for local development (default in dev)
#   "staging"   → safe for PR previews
#   "prod"      → LIVE PRODUCTION DATA — never set locally or in previews
#
# Client-side (browser reads/writes):
# NEXT_PUBLIC_FIREBASE_DATA_NAMESPACE="local-dev"
# Server-side (API routes, AI Chat, connected accounts):
# FIREBASE_DATA_NAMESPACE="local-dev"
#
# Defaults (if unset):
#   dev  → "local-dev"
#   test → "test"
#   prod → "prod"

# ── Firebase Admin (required for server auth features) ─────────────────
# Needed for server-side Firebase ID token verification used by
# connected accounts (Upstox, Splitwise) and AI Chat endpoints.
# Generate a private key: Project Settings → Service accounts → Generate key
# FIREBASE_ADMIN_PROJECT_ID="YOUR_PROJECT_ID"
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── Server-Only Price Provider Keys (optional) ─────────────────────────
# Only needed if you use premium price feeds. The app works without these
# using Yahoo Finance fallback for most tickers.
# MASSIVE_API_KEY=""
# ALPHA_VANTAGE_API_KEY=""

# ── Connected Accounts — Upstox (optional) ─────────────────────────────
# Only needed for Upstox India stock integration. Skip if not using.
# UPSTOX_CLIENT_ID=""
# UPSTOX_CLIENT_SECRET=""
# UPSTOX_REDIRECT_URI="http://localhost:6868/api/connections/upstox/callback"
# CONNECTED_ACCOUNTS_ENCRYPTION_KEY="long-random-secret"
# CONNECTED_ACCOUNTS_STATE_SECRET="long-random-secret"

# ── Connected Accounts — Splitwise (optional) ──────────────────────────
# Only needed for Splitwise debt tracking integration. Skip if not using.
# SPLITWISE_CLIENT_ID=""
# SPLITWISE_CLIENT_SECRET=""
# SPLITWISE_REDIRECT_URI="http://localhost:6868/api/splitwise/callback"
# SPLITWISE_STATE_SECRET=""
# INTEGRATION_TOKEN_ENCRYPTION_KEY=""
# SPLITWISE_API_BASE_URL="https://secure.splitwise.com/api/v3.0"
# SPLITWISE_OAUTH_TOKEN_URL="https://secure.splitwise.com/oauth/token"
# SPLITWISE_OAUTH_AUTHORIZE_URL="https://secure.splitwise.com/oauth/authorize"

# ── Docker Self-Host: Storage Driver (optional) ────────────────────────
# Controls where server-owned data is stored (AI credentials, onboarding,
# workspace ownership, connected account snapshots).
#   "firebase" → (default) Firestore via Firebase Admin SDK
#   "sqlite"   → local SQLite file (set SQLITE_PATH)
#   "postgres" → remote Postgres (set DATABASE_URL)
#
# Portfolio data always lives in Firebase Firestore (client-side) regardless
# of this setting. Only server-side stores are redirected.
# NEXUS_STORAGE_DRIVER="firebase"
# SQLITE_PATH="./data/nexus.db"
# DATABASE_URL="postgres://user:password@host:5432/nexus"

# ── General ────────────────────────────────────────────────────────────
# APP_BASE_URL="http://localhost:6868"
# VITE_GOOGLE_CLIENT_ID=""
# VITE_LOGO_DEV_PUBLISHABLE_KEY=""
# LOGO_DEV_SECRET_KEY=""

# ── Legacy (do not use) ────────────────────────────────────────────────
# VITE_LOCAL_TEST_MODE is deprecated — use VITE_MOCK_MODE=mock instead.
